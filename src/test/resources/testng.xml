<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Stellar Burgers Tests" parallel="tests" thread-count="2" verbose="1">

    <!-- Chrome браузер -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.stellar.burgers.tests.LoginTest"/>
            <class name="com.stellar.burgers.tests.RegistrationTest"/>
            <class name="com.stellar.burgers.tests.ConstructorTest"/>
        </classes>
    </test>

    <!-- Яндекс браузер -->
    <test name="Yandex Tests">
        <parameter name="browser" value="yandex"/>
        <classes>
            <class name="com.stellar.burgers.tests.LoginTest"/>
            <class name="com.stellar.burgers.tests.RegistrationTest"/>
            <class name="com.stellar.burgers.tests.ConstructorTest"/>
        </classes>
    </test>

</suite>